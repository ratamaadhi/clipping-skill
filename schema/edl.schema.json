{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipping-skill/schema/edl.schema.json",
  "title": "Edit Decision List",
  "description": "Artefak pusat. Semua keputusan render dinyatakan di sini; renderer tidak boleh punya logika kreatif. Waktu caption adalah waktu OUTPUT (relatif ke awal klip), bukan waktu sumber.",
  "type": "object",
  "required": ["version", "source", "output", "clips"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": "0.1.0"},
    "source": {
      "type": "object",
      "required": ["path", "duration", "fps", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "duration": {"type": "number", "minimum": 0},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "audio_rate": {"type": "integer"},
        "loudness_lufs": {"type": ["number", "null"]}
      }
    },
    "output": {
      "type": "object",
      "required": ["width", "height", "fps"],
      "additionalProperties": false,
      "properties": {
        "width": {"const": 1080},
        "height": {"const": 1920},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "loudness_lufs": {"type": "number", "default": -14},
        "true_peak_db": {"type": "number", "default": -1}
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/clip"}
    }
  },
  "$defs": {
    "clip": {
      "type": "object",
      "required": ["id", "segments", "captions", "reframe", "score"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^clip_[0-9]{2,}$"},
        "score": {"$ref": "#/$defs/score"},
        "segments": {
          "type": "array",
          "minItems": 1,
          "description": "potongan kontinu dari sumber, diurutkan. v0 hanya mengisi satu.",
          "items": {
            "type": "object",
            "required": ["src_start", "src_end"],
            "additionalProperties": false,
            "properties": {
              "src_start": {"type": "number", "minimum": 0},
              "src_end": {"type": "number", "minimum": 0},
              "speed": {"type": "number", "exclusiveMinimum": 0, "default": 1.0},
              "out_start": {
                "type": "number",
                "minimum": 0,
                "description": "posisi segmen ini di timeline output; bila kosong dihitung otomatis"
              }
            }
          }
        },
        "captions": {
          "type": "array",
          "description": "waktu relatif terhadap awal KLIP (output timeline)",
          "items": {
            "type": "object",
            "required": ["start", "end", "text"],
            "additionalProperties": false,
            "properties": {
              "start": {"type": "number", "minimum": 0},
              "end": {"type": "number", "minimum": 0},
              "text": {"type": "string", "minLength": 1},
              "emphasis": {"type": "string", "description": "satu kata di dalam text yang diberi penekanan"},
              "src_start": {"type": "number", "description": "jejak balik ke waktu sumber, untuk debugging drift"}
            }
          }
        },
        "reframe": {
          "type": "object",
          "required": ["mode"],
          "additionalProperties": false,
          "properties": {
            "mode": {"enum": ["center", "track", "pad"]},
            "bias_x": {"type": "number", "minimum": -1, "maximum": 1, "default": 0},
            "bias_y": {"type": "number", "minimum": -1, "maximum": 1, "default": 0},
            "keyframes": {
              "type": "array",
              "description": "dipakai bila mode=track; v1",
              "items": {
                "type": "object",
                "required": ["t", "x", "y"],
                "properties": {
                  "t": {"type": "number"},
                  "x": {"type": "number"},
                  "y": {"type": "number"},
                  "scale": {"type": "number"}
                }
              }
            }
          }
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "music_path": {"type": ["string", "null"]},
            "music_gain_db": {"type": "number", "default": -18},
            "duck_db": {"type": "number", "default": -12},
            "sfx": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["t", "path"],
                "properties": {
                  "t": {"type": "number"},
                  "path": {"type": "string"},
                  "gain_db": {"type": "number", "default": -20}
                }
              }
            }
          }
        },
        "overlays": {
          "type": "array",
          "description": "reserved untuk template Remotion (v1)",
          "items": {"type": "object"}
        }
      }
    },
    "score": {
      "type": "object",
      "required": ["axes", "base", "penalty", "final", "percentile"],
      "additionalProperties": false,
      "properties": {
        "axes": {
          "type": "object",
          "additionalProperties": {"type": "number"}
        },
        "base": {"type": "number"},
        "penalty": {"type": "number"},
        "final": {"type": "number", "minimum": 0, "maximum": 100},
        "percentile": {"type": "number", "minimum": 0, "maximum": 100},
        "weakest_axis": {"type": "string"},
        "fix_suggestion": {"type": "string"}
      }
    }
  }
}
