# Salin ke .env lalu isi salah satu.
# Riset lengkap jalur gratis: docs/TRANSCRIPTION.md

# ── Transkripsi ──────────────────────────────────────────────────────────────
# REKOMENDASI: groq — gratis ~8 jam audio/hari, whisper-large-v3-turbo,
# WER Bahasa Indonesia ~7%, tanpa RAM lokal. Cukup untuk 5-20 video/minggu.
GROQ_API_KEY=

# Fallback cloud: nova-3, diarization (siapa bicara), $200 kredit sekali pakai.
DEEPGRAM_API_KEY=

# Berbayar per menit; hanya kalau sudah punya kredit.
OPENAI_API_KEY=

# local | groq | deepgram | openai  (kosong = auto-deteksi dari key yang ada)
CLIP_ENGINE=

# Bahasa sumber; kosong = auto-detect. Isi "id" supaya tidak salah ke Melayu.
CLIP_LANGUAGE=id

# ── Pipeline ─────────────────────────────────────────────────────────────────
# Jumlah kandidat yang dikirim ke agent untuk dinilai.
CLIP_TOP_N=15

# Panjang chunk audio untuk API (detik). Default 600.
# File panjang tetap di-chunk walau muat: satu request gagal tidak membuang semua,
# dan loop halusinasi Whisper tidak menjalar.
CLIP_CHUNK_SECONDS=600

# ── Transkripsi lokal (opsional) ─────────────────────────────────────────────
# Butuh venv Python 3.11-3.12 (ctranslate2 belum ada wheel untuk 3.14):
#   pip install faster-whisper
# Model: tiny | base | small | medium | large-v3 | large-v3-turbo
# Untuk Bahasa Indonesia jangan pakai di bawah "small".
CLIP_WHISPER_MODEL=small
