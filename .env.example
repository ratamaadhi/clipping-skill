# Salin ke .env lalu isi salah satu.
# Transkripsi: pilih satu engine.

# termurah + tercepat, whisper-large-v3-turbo, word-level OK
GROQ_API_KEY=

# whisper-1, word-level OK
OPENAI_API_KEY=

# nova-3, diarization + punctuate, bagus untuk wawancara
DEEPGRAM_API_KEY=

# local | groq | openai | deepgram  (kosong = auto-deteksi dari key yang ada)
CLIP_ENGINE=

# bahasa sumber; kosong = auto-detect
CLIP_LANGUAGE=id

# jumlah kandidat yang dikirim ke agent untuk dinilai
CLIP_TOP_N=15
