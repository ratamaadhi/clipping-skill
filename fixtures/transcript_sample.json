  "segments": [
    {
      "start": 0.0,
      "end": 5.868,
      "text": "Oke jadi hari ini gue mau bahas satu hal yang mungkin bikin kalian kaget.",
      "speaker": 0
    },
    {
      "start": 6.218,
      "end": 12.625,
      "text": "Eee jadi ceritanya gue udah nyoba dua tool coding AI selama tiga bulan terakhir.",
      "speaker": 0
    },
    {
      "start": 12.975,
      "end": 16.216,
      "text": "Pertama itu Codex, kedua itu Claude.",
      "speaker": 0
    },
    {
      "start": 16.566,
      "end": 22.688,
      "text": "Nah yang menarik itu bedanya bukan di kecepatan, tapi di cara mereka mikir.",
      "speaker": 0
    },
    {
      "start": 23.038,
      "end": 29.272,
      "text": "Contohnya waktu gue minta bikin endpoint baru, Codex langsung nulis kodenya.",
      "speaker": 0
    },
    {
      "start": 29.622,
      "end": 36.035,
      "text": "Tapi Claude malah balik nanya dulu, ini datanya dari mana dan siapa yang akses.",
      "speaker": 0
    },
    {
      "start": 36.385,
      "end": 41.244,
      "text": "Dan menurut gue itu justru yang bikin hasilnya lebih bener.",
      "speaker": 0
    },
    {
      "start": 41.594,
      "end": 47.864,
      "text": "Jadi intinya gue nemu tiga perbedaan besar yang bikin gue milih salah satunya.",
      "speaker": 0
    },
    {
      "start": 48.214,
      "end": 55.028,
      "text": "Yang pertama soal konteks, Claude bisa inget delapan file sekaligus tanpa gue ulang.",
      "speaker": 0
    },
    {
      "start": 55.378,
      "end": 61.868,
